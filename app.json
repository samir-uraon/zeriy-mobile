{
  "expo": {
    "name": "Zeriy",
    "slug": "zeriy",
    "owner": "zeriy2026",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zeriy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Zeriy uses your location to show directions."
      }
    },
    "android": {
      "package": "com.zeriy.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "zeriy",
              "host": "auth",
              "pathPrefix": "/callback"
            }
          ]
        }
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
  "plugins": [
  "expo-router",

  "expo-secure-store",
  "expo-web-browser",
  [
    "expo-notifications",
    {
      "defaultChannel": "default",
      "icon": "./assets/images/icon.png",
      "color": "#6C3CE9"
    }
  ]
],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f582edbc-ca81-4641-86fa-12aa2d161375"
      }
    }
  }
}